# ==========================================
# 基础设施连接配置 (指向 192.168.6.134 节点)
# ==========================================
MONGO_HOST=192.168.6.134
MONGO_PORT=27017
MONGO_DB_NAME=tradedoc_ai
MONGO_URI=mongodb://192.168.6.134:27017/tradedoc_ai

MILVUS_HOST=192.168.6.134
MILVUS_PORT=19530
MILVUS_COLLECTION_NAME=material_vector_index

# ==========================================
# 模型与第三方服务配置 [请在此填写你的 API KEY]
# ==========================================
# [待填写]: 请填入你的阿里云百炼 DashScope API Key (例如 sk-xxxx)，用于 Qwen-VL 图片单据解析与通义千问问答
DASHSCOPE_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL_NAME=qwen-plus
QWEN_VL_MODEL_NAME=qwen-vl-plus

# ==========================================
# 服务运行参数
# ==========================================
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]
